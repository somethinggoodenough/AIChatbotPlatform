# Select one endpoint + model profile. Paths are relative to the repository root.
PROVIDER_PROFILE=configs/providers/local_sglang.toml

# Set this to the exact model id exposed by your SGLang server.
SGLANG_BASE_URL=http://127.0.0.1:30000/v1
# Temporary spike model; not the final Router/guardrail model selection.
SGLANG_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SGLANG_API_KEY=
SGLANG_IMAGE=lmsysorg/sglang:v0.5.19-cu129
SGLANG_CONTEXT_LENGTH=4096
SGLANG_MEM_FRACTION=0.65

# DeepSeek's OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Additional provider profiles. Model is intentionally blank until selected;
# each model's exact capabilities and pricing still need verification.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=
GEMINI_API_KEY=

# Future providers:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=
# ANTHROPIC_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=
# XAI_API_KEY=
